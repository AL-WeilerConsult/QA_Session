table _Measures
	lineageTag: acc6f3b3-b4c8-4915-96bb-d5225ff3a08c

	measure Test = "Test"
		lineageTag: 132d96ca-751a-4c27-9ffb-e28642d94fb6

	/// Durchschnittliche Bewertung der Filme auf Basis von Vote_Average. Filme ohne Bewertung (leere Werte) fließen nicht in den Durchschnitt ein.
	measure Durchschnittsbewertung = AVERAGE(Fakt_movies[Vote_Average])
		formatString: 0.0
		displayFolder: 01 Basis-KPIs
		lineageTag: 28c6c874-7669-4096-bfd2-7df331ead3dc

	/// Durchschnittlicher Umsatz je Film: Summe des Umsatzes geteilt durch die Anzahl unterschiedlicher Filme (Movie ID). Liefert leer statt Fehler, wenn keine Filme im Filterkontext sind.
	measure 'Umsatz pro Film' = DIVIDE(SUM(Fakt_movies[Umsatz]), DISTINCTCOUNT(Fakt_movies[Movie ID]))
		formatString: #,0 €
		displayFolder: 01 Basis-KPIs
		lineageTag: 278540d0-6320-421c-9eac-d0ed9904e68e

	partition _Measures = m
		mode: import
		queryGroup: '4 - Template/Intern'
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type text) meta [Serialized.Text = true]) in type table [#"Spalte ""1""" = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Spalte ""1""", Int64.Type}}),
				    #"Entfernte Spalten" = Table.RemoveColumns(#"Changed Type",{"Spalte ""1"""})
				in
				    #"Entfernte Spalten"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

