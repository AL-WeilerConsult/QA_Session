	partition Dates = m
		mode: import
		queryGroup: '1 - Final Tables'
		source = ```
				let
				    FixedDate = Report_StartDate_FestesDatum,
				    YearOffset = Report_StartDate_JahreZurück,
				    Today = Date.From(DateTime.LocalNow()),
				
				    ReportStartDate =
				        if FixedDate <> null and YearOffset <> null then
				            error "Bitte nur einen Parameter für das Report Start Date setzen: entweder festes Datum ODER Jahre zurück"
				        else if FixedDate = null and YearOffset = null then
				            error "Bitte einen Parameter für das Report Start Date setzen: festes Datum oder Jahre zurück"
				        else if FixedDate <> null then
				            FixedDate
				        else
				            Date.StartOfYear(Date.AddYears(Today, YearOffset)),
				
				    // Definiere das Enddatum der Dates-Tabelle mittels des Parameters Report_EndDate (leer = Heute, 0 = Dieses Jahr)
				    ReportEndDate = 
				        if #"Report_EndDate (leer = 'bis heute')" = null then Date.From(DateTime.LocalNow()) // wenn Parameter Report_EndDate leer, dann erstelle die Tabelle "bis heute"
				        else Date.From(Date.EndOfYear(Date.AddYears(DateTime.LocalNow(), #"Report_EndDate (leer = 'bis heute')"))), // ansonsten bis Ende des Jahres laut Parameter (0 = dieses Jahr)
				    
				    // Holen der Daten mit der Funktion "Dates Query"
				    Source = #"Dates Query"(ReportStartDate, ReportEndDate, FYStartMonth, #"Holiday List"),
				
				    // Sortieren der Zeilen nach dem Datum in absteigender Reihenfolge
				    #"Sortierte Zeilen" = Table.Sort(Source, {{"Date", Order.Descending}}),
				
				    // Verknüpfung mit der Tabelle "Holiday Grab"
				    #"Merged queries" = Table.NestedJoin(#"Sortierte Zeilen", {"Date"}, #"Holiday Grab", {"Date"}, "Holiday Grab", JoinKind.LeftOuter),
				
				    // Erweitern der Spalte "Holiday Grab" und Umbenennen in "Holiday Name"
				    #"Expanded Holiday Grab" = Table.ExpandTableColumn(#"Merged queries", "Holiday Grab", {"Holiday"}, {"Holiday Name"}),
				    #"Sortierte Zeilen1" = Table.Sort(#"Expanded Holiday Grab",{{"Date", Order.Ascending}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Sortierte Zeilen1",{"ShortYear", "Date_Key", "ISO Year", "Month Name", "Month Name Short3", "Month Number 00", "Month & Year", "DayOfWeek", "DayOfWeekName Short", "DayOfMonth 00", "WeekEnding", "MonthEnding", "YearQuarter", "YearMonth", "YearCW", "Fiscal Year", "FY", "Fiscal Quarter", "FYQ", "Fiscal Month", "FYM", "IsAfterToday", "DayOffset", "WeekOffset", "MonthOffset", "QuarterOffset", "YearOffset", "FiscalYearOffset", "WeekCompleted", "MonthCompleted", "QuarterCompleted", "Year with Actual DE", "Quarter&Year with Actual DE", "Month&Year with Actual DE", "Week&Year with Actual DE", "Date with Actual DE", "Year with Actual", "Quarter&Year with Actual", "Month&Year with Actual", "Week&Year with Actual", "Date with Actual", "Date Text", "Date Text DE", "Holiday Name", "DayOfWeekName", "DayOfWeekName DE Short2"})
				in
				    #"Removed Columns"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

