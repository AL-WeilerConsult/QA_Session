				UNION(
				    SELECTCOLUMNS(INFO.VIEW.MEASURES(), "Art", "Measure", "Name", [Name], "Table", [Table], "Description", [Description], "IsHidden", [IsHidden], "Expression", [Expression]),
				    SELECTCOLUMNS(INFO.VIEW.COLUMNS(), "Art", "Column", "Name", [Name], "Table", [Table], "Description", [Description], "IsHidden", [IsHidden], "Expression", [Expression]),
				    SELECTCOLUMNS(INFO.VIEW.TABLES(), "Art", "Table", "Name", [Name], "Table", [Name], "Description", [Description], "IsHidden", [IsHidden], "Expression", [Expression])
				)
				
				```

