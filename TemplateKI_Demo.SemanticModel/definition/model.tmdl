model Model
	culture: de-DE
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: de-DE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup '1 - Final Tables'

	annotation PBI_QueryGroupOrder = 0

queryGroup '2 - Transformation'

	annotation PBI_QueryGroupOrder = 1

queryGroup '4 - Template/Intern'

	annotation PBI_QueryGroupOrder = 2

queryGroup '3 - Raw Data'

	annotation PBI_QueryGroupOrder = 3

queryGroup '4 - Template/Intern\Parameter'

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["_Measures","_Measures Template","Changelog","Z_lastRefresh","Language","Dates Query","Feiertage","Holiday Grab","Holiday List","Report_StartDate_FestesDatum","Report_StartDate_JahreZurück","Report_EndDate (leer = 'bis heute')","Berichtsstatus","FYStartMonth","LinkZuOneDrive","Deutsche Zeit","Dates","Fakt_movies"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DaxQueryView_Desktop","TMDLView_Desktop","CalcGroup","MCP-PBIModeling","DevMode"]

ref table Z_lastRefresh
ref table Language
ref table '_Measures Template'
ref table Changelog
ref table Berichtsstatus
ref table Doku
ref table RefreshSources
ref table _Measures
ref table 'Time Intelligence'
ref table Dates
ref table Fakt_movies

ref cultureInfo de-DE

