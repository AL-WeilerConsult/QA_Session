expression 'Dates Query' = ```
		let
		  fnDateTable = (StartDate as date, EndDate as date, optional FYStartMonth as number, optional Holidays as list ) as table =>
		  let
		    FYStartMonth = try if List.Contains( {1..12}, FYStartMonth ) then FYStartMonth else 1 otherwise 1,
		    CurrentDate = DateTime.Date(DateTime.FixedLocalNow()),
		    DayCount = Duration.Days(Duration.From(EndDate - StartDate))+1,
		    Source = List.Dates(StartDate,DayCount,#duration(1,0,0,0)),
		    AddToday = if EndDate < CurrentDate then List.Combine( {Source, {CurrentDate}}) else Source,
		    TableFromList = Table.FromList(AddToday, Splitter.SplitByNothing()),
		    ChangedType = Table.TransformColumnTypes(TableFromList,{{"Column1", type date}}),
		    RenamedColumns = Table.RenameColumns(ChangedType,{{"Column1", "Date"}}),
		    InsertYear = Table.AddColumn(RenamedColumns, "Year", each Date.Year([Date]), Int64.Type),
		    InsertShortYear = Table.AddColumn(InsertYear, "ShortYear", each Text.End(Number.ToText([Year]), 2), type text),
		    InsertQuarter = Table.AddColumn(InsertShortYear, "QuarterOfYear", each Date.QuarterOfYear([Date]), Int64.Type),
		    InsertMonth = Table.AddColumn(InsertQuarter, "MonthOfYear", each Date.Month([Date]),Int64.Type),
		    InsertDay = Table.AddColumn(InsertMonth, "DayOfMonth", each Date.Day([Date]), Int64.Type),
		    InsertDayInt = Table.AddColumn(InsertDay, "Date_Key", each [Year] * 10000 + [MonthOfYear] * 100 + [DayOfMonth],Int64.Type),
		
		    InsertISOWeekNumber= Table.AddColumn(InsertDayInt, "ISO Weeknumber", each
		      if Number.RoundDown((Date.DayOfYear([Date])-(Date.DayOfWeek([Date], Day.Monday)+1)+10)/7)=0
		      then Number.RoundDown((Date.DayOfYear(#date(Date.Year([Date])-1,12,31))-(Date.DayOfWeek(#date(Date.Year([Date])-1,12,31), Day.Monday)+1)+10)/7)
		      else if (Number.RoundDown((Date.DayOfYear([Date])-(Date.DayOfWeek([Date], Day.Monday)+1)+10)/7)=53 and (Date.DayOfWeek(#date(Date.Year([Date]),12,31), Day.Monday)+1<4))
		      then 1 else Number.RoundDown((Date.DayOfYear([Date])-(Date.DayOfWeek([Date], Day.Monday)+1)+10)/7), Int64.Type),
		    InsertISOyear = Table.AddColumn(InsertISOWeekNumber, "ISO Year", each Date.Year( Date.AddDays( Date.StartOfWeek([Date], Day.Monday), 3 )),  Int64.Type),
		    BufferTable = Table.Buffer(Table.Distinct( InsertISOyear[[ISO Year], [Date_Key]])),
		    InsertISOday = Table.AddColumn(InsertISOyear, "ISO DayOfYear", (OT) => Table.RowCount( Table.SelectRows( BufferTable, (IT) => IT[Date_Key] <= OT[Date_Key] and IT[ISO Year] = OT[ISO Year])),  Int64.Type),
		
		    InsertMonthName = Table.AddColumn(InsertISOday, "Month Name DE", each  Date.MonthName([Date], "de-DE"), type text),
		    InsertMonthName3Dig = Table.AddColumn(InsertMonthName, "Month Name DE Short3", each Text.Start([Month Name DE], 3), type text),
		    InsertMonthNameEN = Table.AddColumn(InsertMonthName3Dig, "Month Name", each Date.MonthName([Date], "en-US"), type text),
		    InsertMonthNameEN3Dig = Table.AddColumn(InsertMonthNameEN, "Month Name Short3", each Text.Start([Month Name],3), type text),    
		    InsertMonth2 = Table.AddColumn(InsertMonthNameEN3Dig, "Month Number 00", each Text.PadStart(Number.ToText([MonthOfYear]),2,"0"), type text),
		
		    InsertCalendarMonth = Table.AddColumn(InsertMonth2, "Month & Year", each (try(Text.Range([Month Name Short3],0,3)) otherwise [Month Name]) & " " & Text.End(Number.ToText([Year]),2), type text),
		    InsertCalendarMonthDE = Table.AddColumn(InsertCalendarMonth, "Month & Year DE", each (try(Text.Range([Month Name DE Short3],0,3)) otherwise [Month Name DE]) & " " & Text.End(Number.ToText([Year]),2), type text),
		    InsertCalendarQtr = Table.AddColumn(InsertCalendarMonthDE, "Quarter & Year", each "Q" & Number.ToText([QuarterOfYear]) & " " & Text.End(Number.ToText([Year]),2), type text),
		    InsertCalendarW = Table.AddColumn(InsertCalendarQtr, "Week & Year", each "W" & Text.PadStart(Number.ToText([ISO Weeknumber]),2,"0") & " " & Text.End(Number.ToText([ISO Year]),2), type text),   
		
		    InsertDayWeek = Table.AddColumn(InsertCalendarW, "DayOfWeek", each Date.DayOfWeek([Date], Day.Monday)+1, Int64.Type),
		    InsertDayName = Table.AddColumn(InsertDayWeek, "DayOfWeekName", each Date.DayOfWeekName([Date], "en-US"), type text),
		    InsertDayName3 = Table.AddColumn(InsertDayName, "DayOfWeekName Short", each Text.Start([DayOfWeekName],3), type text),
		    InsertDayOfMonth2 = Table.AddColumn(InsertDayName3, "DayOfMonth 00", each Text.PadStart(Number.ToText([DayOfMonth]), 2, "0"), type text),
		    InsertDayName2digDE= Table.AddColumn(InsertDayOfMonth2, "DayOfWeekName DE Short2", each Text.Start(Date.DayOfWeekName([Date],"de-DE"),2),type text),
		
		    InsertWeekEnding = Table.AddColumn(InsertDayName2digDE, "WeekEnding", each Date.EndOfWeek( [Date], Day.Monday), type date),
		    InsertMonthEnding = Table.AddColumn(InsertWeekEnding, "MonthEnding", each Date.EndOfMonth([Date]), type date),
		   
			  InsertYearQuarter = Table.AddColumn(InsertMonthEnding, "YearQuarter", each [ShortYear] & "Q" & Number.ToText([QuarterOfYear],"0"), type text),
		    InsertYearMonth = Table.AddColumn(InsertYearQuarter , "YearMonth", each [ShortYear] & "M" & [Month Number 00], type text),
		    InsertYearCW = Table.AddColumn(InsertYearMonth, "YearCW", each Text.Combine({Text.End(Number.ToText([ISO Year]),2), Text.PadStart(Number.ToText([ISO Weeknumber]),2,"0")}, "W"), type text),
		  //  InsertDayID = Table.AddColumn(InsertYearCW, "Day_ID", each Text.Combine({[ShortYear], [Month Number2],Number.ToText([DayOfMonth],"0#")}, "_"), type text),
		    
		    InsertWeek_Key = Table.AddColumn(InsertYearCW, "Week_Key", each [ISO Year] * 100 + [ISO Weeknumber] * 1,  Int64.Type),
		    InsertMonth_Key = Table.AddColumn(InsertWeek_Key , "Month_Key", each [Year] * 100 + [MonthOfYear] * 1, Int64.Type),
		    InsertQuarter_Key = Table.AddColumn(InsertMonth_Key, "Quarter_Key", each [Year] * 100 + [QuarterOfYear] * 1, Int64.Type),
		
		    AddFY = Table.AddColumn(InsertQuarter_Key, "Fiscal Year", each if FYStartMonth = 1 then[Year] else if [MonthOfYear]>=FYStartMonth then [Year] else [Year]-1, Int64.Type),
		    /* AddFY = Table.AddColumn(InsertQuarter_Key, "Fiscal Year",
		      each if [Year]<2020 then[Year] 
		      else if [Year]=2020 and [MonthOfYear] <=3 then [Year] 
		      else if [Year]>=2020 and [MonthOfYear] < FYStartMonth then [Year]
		      else if [Year]>=2020 and [MonthOfYear] >= FYStartMonth then [Year]+1
		      else [Year]-1
		    , Int64.Type), */
		
		    AddFYShort = Table.AddColumn(AddFY, "FY", each "FY"& Text.End(Text.From([Fiscal Year]),2), type text),
		    AddFQ = Table.AddColumn(AddFYShort, "Fiscal Quarter", each Number.RoundUp( Date.Month( Date.AddMonths( [Date], - (FYStartMonth -1) )) / 3 ), Int64.Type),
		   /*  AddFQ = Table.AddColumn(AddFYShort, "Fiscal Quarter", 
		      each if [Fiscal Year]=2020 and [MonthOfYear] <=3 then [QuarterOfYear]
		      else if [Year]>=2020 then Number.RoundUp( Date.Month( Date.AddMonths( [Date], - (FYStartMonth -1) )) / 3 )
		      else [QuarterOfYear]
		    , Int64.Type), */
		    AddFYQ = Table.AddColumn(AddFQ, "FYQ", each [FY] & " Q" & Text.From([Fiscal Quarter]), type text),
		    AddFM = Table.AddColumn(AddFYQ, "Fiscal Month", each if [MonthOfYear]>=FYStartMonth then [MonthOfYear]-(FYStartMonth-1) else [MonthOfYear]+(12-FYStartMonth+1), Int64.Type),
		  /*   AddFM = Table.AddColumn(AddFYQ, "Fiscal Month", 
		      each if [Fiscal Year]<=2020 then [MonthOfYear] 
		      else if [Fiscal Year]>=2021 and [MonthOfYear]>=FYStartMonth then [MonthOfYear]-(FYStartMonth-1) 
		      else [MonthOfYear]+(12-FYStartMonth+1)
		    , Int64.Type), */
		    AddFYM = Table.AddColumn(AddFM, "FYM", each [FY]&" M"&Text.PadStart(Number.ToText([Fiscal Month]),2,"0"), type text),
		
		    InsertIsAfterToday = Table.AddColumn(AddFYM, "IsAfterToday", each not ([Date] <= Date.From(CurrentDate)), type logical),
		    InsertIsHoliday = Table.AddColumn(InsertIsAfterToday, "IsHoliday", each if Holidays = null then 0 else List.Contains( Holidays, [Date] ), type logical),
		    InsertIsWorkingDay = Table.AddColumn(InsertIsHoliday, "IsWorkingDay", each if [DayOfWeek] = 6 or [DayOfWeek] = 7 or [IsHoliday] = true then 0 else 1, Int8.Type),
		
		    InsertDayOffset = Table.AddColumn(InsertIsWorkingDay, "DayOffset", each Number.From([Date])-Number.From(CurrentDate), Int64.Type),
		    InsertWeekOffset = Table.AddColumn(InsertDayOffset, "WeekOffset", each (Number.From(Date.StartOfWeek([Date], Day.Monday))-Number.From(Date.StartOfWeek(CurrentDate, Day.Monday)))/7, Int64.Type),
		    InsertMonthOffset = Table.AddColumn(InsertWeekOffset, "MonthOffset", each ((12 * Date.Year([Date])) +  Date.Month([Date])) - ((12 * Date.Year(Date.From(CurrentDate))) +  Date.Month(Date.From(CurrentDate))),Int64.Type),
		    InsertQuarterOffset = Table.AddColumn(InsertMonthOffset, "QuarterOffset", each ((4 * Date.Year([Date])) +  Date.QuarterOfYear([Date])) - ((4 * Date.Year(Date.From(CurrentDate))) +  Date.QuarterOfYear(Date.From(CurrentDate))), Int64.Type),
		    InsertYearOffset = Table.AddColumn(InsertQuarterOffset, "YearOffset", each Date.Year([Date]) - Date.Year(Date.From(CurrentDate)), type number),
		
		    IdentifyCurrentDate = Table.SelectRows(InsertYearOffset, each ([Date] = CurrentDate)),
		    CurrentFiscalYear = IdentifyCurrentDate{0}[FY], 
		    InsertFYoffset = Table.AddColumn(InsertYearOffset, "FiscalYearOffset", each try Number.From(Text.Range([FY],2,2)) - Number.From(Text.Range(CurrentFiscalYear,2,2)) otherwise null, Int64.Type),
		    RemoveToday = if EndDate < CurrentDate then Table.SelectRows(InsertFYoffset, each ([Date] <> CurrentDate)) else InsertFYoffset,
		    InsertCompletedWeek = Table.AddColumn(RemoveToday, "WeekCompleted", each [WeekEnding] < Date.From(Date.EndOfWeek(CurrentDate)), type logical),
		    InsertCompletedMonth = Table.AddColumn(InsertCompletedWeek, "MonthCompleted", each [MonthEnding] < Date.From(Date.EndOfMonth(CurrentDate)), type logical),
		    InsertCompletedQuarter = Table.AddColumn(InsertCompletedMonth, "QuarterCompleted", each Date.EndOfQuarter([Date]) < Date.From(Date.EndOfQuarter(CurrentDate)), type logical),
		
		    InsertJMitAkt = Table.AddColumn(InsertCompletedQuarter, "Year with Actual DE", each if [YearOffset]= 0 then "Akt. Jahr" else if [YearOffset]= -1 then "Vorjahr" else Number.ToText([Year]), type text),
		    InsertQMitAkt = Table.AddColumn(InsertJMitAkt, "Quarter&Year with Actual DE", each if [QuarterOffset]= 0 then "Akt. Quartal" else if [QuarterOffset]= -1 then "Vorquartal" else [#"Quarter & Year"], type text),
		    InsertMMitAkt = Table.AddColumn(InsertQMitAkt, "Month&Year with Actual DE", each if [MonthOffset]= 0 then "Akt. Monat" else if [MonthOffset]= -1 then "Vormonat" else [#"Month & Year DE"], type text),
		    InsertWMitAkt = Table.AddColumn(InsertMMitAkt, "Week&Year with Actual DE", each if [WeekOffset]= 0 then "Akt. Woche" else if [WeekOffset]= -1 then "Vorwoche" else [#"Week & Year"], type text),
		    InsertDMitAkt = Table.AddColumn(InsertWMitAkt, "Date with Actual DE", each if [DayOffset]= 0 then "Heute" else if [DayOffset]= -1 then "Gestern" else if [DayOffset]= -2 then "Vorgestern" else Date.ToText([Date]), type text),
		   
		    InsertYWithAct = Table.AddColumn(InsertDMitAkt, "Year with Actual", each if [YearOffset]= 0 then "Act. Year" else if [YearOffset]= -1 then "Prev. Year" else Number.ToText([Year]), type text),
		    InsertQWithAct = Table.AddColumn(InsertYWithAct, "Quarter&Year with Actual", each if [QuarterOffset]= 0 then "Act. Quarter" else if [QuarterOffset]= -1 then "Prev. Quarter" else [#"Quarter & Year"], type text),
		    InsertMWithAct = Table.AddColumn(InsertQWithAct, "Month&Year with Actual", each if [MonthOffset]= 0 then "Act. Month" else if [MonthOffset]= -1 then "Prev. Month" else [#"Month & Year DE"], type text),
		    InsertWWithAct = Table.AddColumn(InsertMWithAct, "Week&Year with Actual", each if [WeekOffset]= 0 then "Act. Week" else if [WeekOffset]= -1 then "Prev. Week" else [#"Week & Year"], type text),
		    InsertDWithAct = Table.AddColumn(InsertWWithAct, "Date with Actual", each if [DayOffset]= 0 then "Today" else if [DayOffset]= -1 then "Yesterday" else if [DayOffset]= -2 then "Bef. Yest." else Date.ToText([Date]), type text),
		
		    InsertDateText = Table.AddColumn(InsertDWithAct, "Date Text", each Text.Start([DayOfWeekName Short],2) & ", " & Text.From([DayOfMonth 00]) & "." &  [Month Number 00] & "." & Text.From([ShortYear]), type text),
		    InsertDatumText = Table.AddColumn(InsertDateText, "Date Text DE", each [DayOfWeekName DE Short2] & ", " & Text.From([DayOfMonth 00]) & "." &  [Month Number 00] & "." & Text.From([ShortYear]), type text)
		
		 
		  in
		InsertDatumText
		in
		  fnDateTable
		```
